{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "jsx": "react-jsx",
    "types": [
      "react",
      "node"
    ],
    "baseUrl": ".",
    "paths": {
      "@cadencia/contrato": [
        "../../packages/contrato/src/index.ts"
      ],
      "@cadencia/dominio": [
        "../../packages/dominio/src/index.ts"
      ],
      "@cadencia/cliente-api": [
        "../../packages/cliente-api/src/index.ts"
      ]
    }
  },
  "include": [
    "src",
    "*.js",
    "*.json",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ]
}

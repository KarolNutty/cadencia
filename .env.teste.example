# Ambiente dos testes de integração. Copie para .env.teste.
#
# Aponta para o segundo Postgres do docker-compose, na porta 5433. O banco de
# teste é recriado a cada execução — por isso o nome PRECISA conter "teste":
# há uma checagem que recusa apagar qualquer outro.

NODE_ENV=test
DATABASE_URL=postgresql://cadencia:cadencia@localhost:5433/cadencia_teste

SEGREDO_ACESSO=teste-kZ8vQ2mN7pR4tY6wA1sD3fG5hJ9lX0cB2nM4
SEGREDO_RENOVACAO=teste-q8Wz3Nv6Ty1Uk4Ri7Op0As5Df2Gh9Jl3xY7
